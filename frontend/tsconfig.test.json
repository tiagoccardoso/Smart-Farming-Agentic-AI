{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/billing/**/*.ts",
    "lib/agronomic/review-workflow.ts",
    "lib/agronomic/client-review.ts",
    "lib/server/supabaseAdmin.ts",
    "lib/stripe/signature.ts",
    "lib/stripe/webhook-events.ts",
    "lib/plans-page.ts",
    "lib/public-requests/config.ts",
    "lib/public-requests/contact.ts",
    "lib/public-requests/form.ts",
    "lib/service-quotes.ts",
    "lib/server/public-requests/attachments.ts",
    "lib/server/public-requests/ai-assist.ts",
    "lib/server/public-requests/rate-limit.ts",
    "lib/server/public-requests/submit.ts",
    "lib/agronomic/analysis-sections.ts",
    "lib/agronomic/ai-response-formatting.ts",
    "lib/agronomic/case-freshness.ts",
    "lib/agronomic/case-chat.ts",
    "lib/agronomic/case-save.ts",
    "lib/agronomic/case-attachments.ts",
    "lib/agronomic/specialist-timeline.ts",
    "lib/server/agronomic-case-edit.ts",
    "lib/server/supabase-rest.ts",
    "lib/mobile-image-upload.ts",
    "lib/agronomic/case-chat-context.ts",
    "lib/agronomic/case-chat-ai.ts",
    "lib/agronomic/chat-markdown.ts",
    "lib/server/case-chat-service.ts",
    "lib/server/case-chat-store.ts",
    "src/lib/ai/providers/*.ts",
    "src/lib/ai/utils/*.ts",
    "lib/agronomic/case-chat-providers.ts",
    "tests/**/*.ts"
  ]
}
